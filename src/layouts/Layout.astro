---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = '滴闯关',
	description = '闯关记录、学习笔记和日常复盘',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/`;
const iconHref = `${base}/favicon.svg`;
const icoHref = `${base}/favicon.ico`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={iconHref} />
		<link rel="icon" href={icoHref} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-nav">
			<a class="brand" href={homeHref} aria-label="滴闯关 首页">
				<img class="brand-mark" src={iconHref} width="36" height="36" alt="" />
				<span>滴闯关</span>
			</a>
			<nav aria-label="主导航">
				<a href={homeHref}>首页</a>
				<a href="https://github.com/" rel="noreferrer">GitHub</a>
			</nav>
		</header>
		<slot />
		<footer class="site-footer">
			<p>Built with Astro. Written slowly, shipped simply.</p>
		</footer>
	</body>
</html>

<style>
	:root {
		--bg: #f6f3eb;
		--surface: #ffffff;
		--surface-strong: #111827;
		--ink: #17202a;
		--muted: #64707d;
		--line: #ded8cb;
		--teal: #0f766e;
		--coral: #e76f51;
		--gold: #d99a25;
		--shadow: 0 18px 50px rgba(17, 24, 39, 0.08);
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
		background:
			radial-gradient(circle at 14% 0%, rgba(15, 118, 110, 0.12), transparent 28rem),
			linear-gradient(180deg, #fbfaf6 0%, var(--bg) 38%, #eef2f1 100%);
		color: var(--ink);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
		line-height: 1.6;
	}

	body {
		width: 100%;
	}

	a {
		color: inherit;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.18em;
	}

	* {
		box-sizing: border-box;
	}

	::selection {
		background: rgba(231, 111, 81, 0.24);
	}

	.site-nav {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(1120px, calc(100% - 32px));
		margin: 0 auto;
		padding: 18px 0;
		backdrop-filter: blur(18px);
	}

	.brand,
	.site-nav nav {
		display: inline-flex;
		align-items: center;
	}

	.brand {
		gap: 10px;
		color: var(--surface-strong);
		font-weight: 800;
		text-decoration: none;
	}

	.brand-mark {
		width: 36px;
		height: 36px;
		border: 1px solid rgba(17, 24, 39, 0.14);
		border-radius: 8px;
		box-shadow: var(--shadow);
	}

	.site-nav nav {
		gap: 8px;
	}

	.site-nav nav a {
		padding: 8px 10px;
		border-radius: 8px;
		color: var(--muted);
		font-size: 0.94rem;
		font-weight: 700;
		text-decoration: none;
	}

	.site-nav nav a:hover,
	.site-nav nav a:focus-visible {
		background: rgba(17, 24, 39, 0.06);
		color: var(--surface-strong);
	}

	.site-footer {
		width: min(1120px, calc(100% - 32px));
		margin: 0 auto;
		padding: 36px 0 48px;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.94rem;
	}

	.site-footer p {
		margin: 0;
	}

	@media (max-width: 640px) {
		.site-nav {
			position: static;
			padding: 14px 0;
		}

		.brand span:last-child {
			display: none;
		}
	}
</style>
