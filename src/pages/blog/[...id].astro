---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('zh-CN', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}).format(date);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/`;
---

<Layout title={`${post.data.title} - 滴闯关`} description={post.data.description}>
	<main class="article-shell">
		<a class="back-link" href={homeHref}>返回首页</a>
		<article>
			<header class="article-header">
				<p class="kicker">Article</p>
				<h1>{post.data.title}</h1>
				<div class="article-meta">
					<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
					<span>{post.data.description}</span>
				</div>
				{
					post.data.tags.length > 0 && (
						<ul class="tags" aria-label="标签">
							{post.data.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					)
				}
			</header>
			<div class="content">
				<Content />
			</div>
		</article>
	</main>
</Layout>

<style>
	.article-shell {
		width: min(920px, calc(100% - 32px));
		margin: 0 auto;
		padding: 42px 0 96px;
	}

	.back-link {
		display: inline-grid;
		margin-bottom: 28px;
		border: 1px solid rgba(17, 24, 39, 0.1);
		border-radius: 8px;
		padding: 8px 12px;
		background: rgba(255, 255, 255, 0.7);
		color: var(--teal);
		font-weight: 700;
		text-decoration: none;
	}

	.back-link:hover,
	.back-link:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.article-header {
		position: relative;
		overflow: hidden;
		border: 1px solid rgba(17, 24, 39, 0.08);
		border-radius: 8px;
		padding: clamp(28px, 7vw, 56px);
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.68)),
			linear-gradient(120deg, rgba(15, 118, 110, 0.12), rgba(231, 111, 81, 0.12));
		box-shadow: var(--shadow);
	}

	.article-header::after {
		position: absolute;
		right: clamp(22px, 5vw, 48px);
		bottom: clamp(18px, 4vw, 36px);
		width: clamp(72px, 16vw, 132px);
		height: clamp(72px, 16vw, 132px);
		border: 1px solid rgba(17, 24, 39, 0.08);
		border-radius: 50%;
		background:
			linear-gradient(135deg, rgba(15, 118, 110, 0.22), transparent 62%),
			linear-gradient(315deg, rgba(231, 111, 81, 0.2), transparent 58%);
		content: "";
	}

	.kicker {
		margin: 0;
		color: var(--teal);
		font-size: 0.84rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	h1 {
		position: relative;
		z-index: 1;
		max-width: 720px;
		margin: 12px 0 22px;
		font-size: clamp(2.35rem, 7vw, 5rem);
		line-height: 1;
		letter-spacing: 0;
	}

	.article-meta {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 6px;
		max-width: 620px;
		color: var(--muted);
		font-size: 1.02rem;
	}

	.article-meta time {
		color: var(--coral);
		font-size: 0.92rem;
		font-weight: 800;
	}

	.article-meta span {
		margin: 0;
	}

	.tags {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 22px 0 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		border: 1px solid rgba(15, 118, 110, 0.2);
		border-radius: 999px;
		padding: 3px 10px;
		background: rgba(15, 118, 110, 0.08);
		color: var(--teal);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.content {
		width: min(720px, 100%);
		margin: 0 auto;
		padding-top: 42px;
		font-size: clamp(1.03rem, 2.3vw, 1.13rem);
		line-height: 1.82;
	}

	.content :global(h2) {
		margin: 2.2rem 0 0.8rem;
		font-size: clamp(1.5rem, 4vw, 2.1rem);
		line-height: 1.25;
		letter-spacing: 0;
	}

	.content :global(h3) {
		margin: 1.8rem 0 0.6rem;
		font-size: 1.35rem;
		line-height: 1.3;
		letter-spacing: 0;
	}

	.content :global(p) {
		margin: 1.1rem 0;
		color: #27313d;
	}

	.content :global(a) {
		color: var(--teal);
		font-weight: 700;
	}

	.content :global(blockquote) {
		margin: 1.4rem 0;
		border-left: 4px solid var(--coral);
		padding: 0.4rem 0 0.4rem 1rem;
		color: var(--muted);
	}

	.content :global(code) {
		border-radius: 6px;
		padding: 0.16em 0.36em;
		background: rgba(17, 24, 39, 0.08);
		font-size: 0.92em;
	}

	.content :global(pre) {
		overflow-x: auto;
		border-radius: 8px;
		padding: 1rem;
		background: #111827;
		color: white;
	}

	.content :global(pre code) {
		padding: 0;
		background: transparent;
		color: inherit;
	}
</style>
