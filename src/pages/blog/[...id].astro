---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('zh-CN', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}).format(date);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/`;
const postHref = (id: string) => `${base}/blog/${id}/`;
const MIN_SERIES_POSTS = 3;
const publishedPosts = (await getCollection('blog')).filter((entry) => !entry.data.draft);
const publishedPostById = new Map(publishedPosts.map((entry) => [entry.id, entry]));
const seriesPosts = post.data.series
	? publishedPosts
			.filter((entry) => entry.data.series?.slug === post.data.series?.slug)
			.sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0))
	: [];
const hasSeriesNavigation = seriesPosts.length >= MIN_SERIES_POSTS;
const currentSeriesPosition = hasSeriesNavigation
	? seriesPosts.findIndex((entry) => entry.id === post.id) + 1
	: 0;
const relatedPosts = post.data.relatedPosts.flatMap((id) => {
	const relatedPost = publishedPostById.get(id);
	return relatedPost && relatedPost.id !== post.id ? [relatedPost] : [];
});
const visibleRelatedPosts = hasSeriesNavigation
	? relatedPosts.filter((entry) => entry.data.series?.slug !== post.data.series?.slug)
	: relatedPosts;
const seriesHubHref = post.data.series?.hub ? `${base}${post.data.series.hub}` : null;
const usesWideTables = post.id === '2026-07-15-2025年上海中本贯通分数线汇总';
const titleLength = Array.from(post.data.title.replace(/\s/g, '')).length;
const usesCompactTitle = titleLength > 22;
const usesExtraCompactTitle = titleLength > 34;
---

<Layout title={`${post.data.title} - 滴闯关`} description={post.data.description}>
	<main class="article-shell">
		<a class="back-link" href={homeHref}>返回首页</a>
		<article>
			<header class="article-header">
				<p class="kicker">Article</p>
				<h1
					class:list={{
						'article-title--compact': usesCompactTitle,
						'article-title--extra-compact': usesExtraCompactTitle,
					}}
				>
					{post.data.title}
				</h1>
				<div class="article-meta">
					<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
					<span>{post.data.description}</span>
				</div>
				{
					post.data.tags.length > 0 && (
						<ul class="tags" aria-label="标签">
							{post.data.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					)
				}
			</header>
			<div class:list={['content', { 'content--wide-tables': usesWideTables }]}>
				<Content />
				{
					hasSeriesNavigation && post.data.series && (
						<nav class="series-navigation" aria-labelledby={`series-title-${post.data.series.slug}`}>
							<div class="series-navigation-header">
								<div>
									<p>专题导航</p>
									<h2 id={`series-title-${post.data.series.slug}`}>{post.data.series.title}</h2>
								</div>
								<span>第 {currentSeriesPosition} / {seriesPosts.length} 篇</span>
							</div>
							<ol>
								{seriesPosts.map((seriesPost, index) => (
									<li class:list={{ 'series-navigation-current': seriesPost.id === post.id }}>
										<span class="series-navigation-number">{String(index + 1).padStart(2, '0')}</span>
										{seriesPost.id === post.id ? (
											<span class="series-navigation-title" aria-current="page">
												{seriesPost.data.title}
												<small>当前文章</small>
											</span>
										) : (
											<a class="series-navigation-title" href={postHref(seriesPost.id)}>
												{seriesPost.data.title}
											</a>
										)}
									</li>
								))}
							</ol>
							{seriesHubHref && <a class="series-hub-link" href={seriesHubHref}>查看专题完整阅读顺序 →</a>}
						</nav>
					)
				}
				{
					visibleRelatedPosts.length > 0 && (
						<aside class="related-posts" aria-labelledby={`related-posts-${post.id}`}>
							<p>继续阅读</p>
							<h2 id={`related-posts-${post.id}`}>相关阅读</h2>
							<ul>
								{visibleRelatedPosts.map((relatedPost) => (
									<li><a href={postHref(relatedPost.id)}>{relatedPost.data.title}</a></li>
								))}
							</ul>
						</aside>
					)
				}
			</div>
		</article>
	</main>
</Layout>

<style>
	.article-shell {
		width: min(920px, calc(100% - 32px));
		margin: 0 auto;
		padding: 42px 0 96px;
	}

	.back-link {
		display: inline-grid;
		margin-bottom: 28px;
		border: 1px solid rgba(17, 24, 39, 0.1);
		border-radius: 8px;
		padding: 8px 12px;
		background: rgba(255, 255, 255, 0.7);
		color: var(--teal);
		font-weight: 700;
		text-decoration: none;
	}

	.back-link:hover,
	.back-link:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.article-header {
		position: relative;
		overflow: hidden;
		border: 1px solid rgba(17, 24, 39, 0.08);
		border-radius: 8px;
		padding: clamp(26px, 5vw, 48px);
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.68)),
			linear-gradient(120deg, rgba(15, 118, 110, 0.12), rgba(231, 111, 81, 0.12));
		box-shadow: var(--shadow);
	}

	.article-header::after {
		position: absolute;
		right: clamp(22px, 5vw, 48px);
		bottom: clamp(18px, 4vw, 36px);
		width: clamp(72px, 16vw, 132px);
		height: clamp(72px, 16vw, 132px);
		border: 1px solid rgba(17, 24, 39, 0.08);
		border-radius: 50%;
		background:
			linear-gradient(135deg, rgba(15, 118, 110, 0.22), transparent 62%),
			linear-gradient(315deg, rgba(231, 111, 81, 0.2), transparent 58%);
		content: "";
	}

	.kicker {
		margin: 0;
		color: var(--teal);
		font-size: 0.84rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	h1 {
		position: relative;
		z-index: 1;
		max-width: 720px;
		margin: 12px 0 22px;
		font-size: clamp(1.9rem, 4.2vw, 3.2rem);
		line-height: 1.06;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	h1.article-title--compact {
		max-width: 780px;
		font-size: clamp(1.75rem, 3.6vw, 2.8rem);
		line-height: 1.12;
	}

	h1.article-title--extra-compact {
		font-size: clamp(1.55rem, 3vw, 2.35rem);
		line-height: 1.16;
	}

	.article-meta {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 6px;
		max-width: 620px;
		color: var(--muted);
		font-size: 1.02rem;
	}

	.article-meta time {
		color: var(--coral);
		font-size: 0.92rem;
		font-weight: 800;
	}

	.article-meta span {
		margin: 0;
	}

	.tags {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 22px 0 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		border: 1px solid rgba(15, 118, 110, 0.2);
		border-radius: 999px;
		padding: 3px 10px;
		background: rgba(15, 118, 110, 0.08);
		color: var(--teal);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.content {
		width: min(720px, 100%);
		margin: 0 auto;
		padding-top: 42px;
		font-size: clamp(1.03rem, 2.3vw, 1.13rem);
		line-height: 1.82;
	}

	.content :global(h2) {
		margin: 2.2rem 0 0.8rem;
		font-size: clamp(1.5rem, 4vw, 2.1rem);
		line-height: 1.25;
		letter-spacing: 0;
	}

	.content :global(h3) {
		margin: 1.8rem 0 0.6rem;
		font-size: 1.35rem;
		line-height: 1.3;
		letter-spacing: 0;
	}

	.content :global(p) {
		margin: 1.1rem 0;
		color: #27313d;
	}

	.content :global(.anchor-target) {
		display: block;
		scroll-margin-top: 88px;
	}

	.content :global(.article-eyebrow) {
		margin: 0 0 0.65rem;
		color: var(--coral);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.content :global(.article-lead) {
		margin: 0 0 1.5rem;
		color: var(--surface-strong);
		font-size: clamp(1.18rem, 2.8vw, 1.36rem);
		font-weight: 540;
		line-height: 1.75;
	}

	.content :global(.source-note) {
		position: relative;
		margin: 1.6rem 0;
		border: 1px solid rgba(217, 154, 37, 0.28);
		border-radius: 14px;
		padding: 1.35rem 1.4rem 1.15rem;
		background:
			linear-gradient(135deg, rgba(255, 251, 235, 0.96), rgba(255, 255, 255, 0.82));
		box-shadow: 0 12px 34px rgba(91, 69, 24, 0.07);
	}

	.content :global(.source-note-label) {
		display: inline-flex;
		margin-bottom: 0.35rem;
		border-radius: 999px;
		padding: 0.18rem 0.65rem;
		background: rgba(217, 154, 37, 0.16);
		color: #9a6511;
		font-size: 0.76rem;
		font-weight: 900;
		letter-spacing: 0.08em;
	}

	.content :global(.source-note p) {
		margin: 0.45rem 0 0;
		font-size: 0.97rem;
		line-height: 1.7;
	}

	.content :global(.article-toc) {
		margin: 1.8rem 0 2.3rem;
		border: 1px solid rgba(15, 118, 110, 0.16);
		border-radius: 14px;
		padding: 1rem 1.1rem 1.1rem;
		background: rgba(255, 255, 255, 0.68);
	}

	.content :global(.article-toc > span) {
		display: block;
		margin-bottom: 0.7rem;
		color: var(--muted);
		font-size: 0.76rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.content :global(.article-toc > div) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.content :global(.article-toc a) {
		border: 1px solid rgba(15, 118, 110, 0.17);
		border-radius: 999px;
		padding: 0.34rem 0.72rem;
		background: rgba(15, 118, 110, 0.06);
		font-size: 0.86rem;
		line-height: 1.35;
		text-decoration: none;
		transition: transform 160ms ease, background 160ms ease;
	}

	.content :global(.article-toc a:hover),
	.content :global(.article-toc a:focus-visible) {
		transform: translateY(-1px);
		background: rgba(15, 118, 110, 0.12);
	}

	.content :global(.stat-grid) {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.8rem;
		margin: 1.3rem 0 1.5rem;
	}

	.content :global(.stat-card) {
		display: grid;
		align-content: start;
		min-height: 142px;
		border: 1px solid rgba(17, 24, 39, 0.08);
		border-radius: 14px;
		padding: 1rem;
		background: rgba(255, 255, 255, 0.76);
		box-shadow: 0 10px 28px rgba(17, 24, 39, 0.055);
	}

	.content :global(.stat-card-primary) {
		border-color: rgba(15, 118, 110, 0.22);
		background: linear-gradient(145deg, rgba(15, 118, 110, 0.14), rgba(255, 255, 255, 0.86));
	}

	.content :global(.stat-card span) {
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 800;
	}

	.content :global(.stat-card strong) {
		margin: 0.2rem 0 0.1rem;
		color: var(--surface-strong);
		font-size: clamp(1.65rem, 4vw, 2.25rem);
		line-height: 1.1;
		letter-spacing: -0.04em;
	}

	.content :global(.stat-card small) {
		align-self: end;
		color: var(--muted);
		font-size: 0.76rem;
		line-height: 1.45;
	}

	.content :global(.insight-strip) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1rem;
		margin: 1rem 0;
		border-left: 4px solid var(--teal);
		border-radius: 0 10px 10px 0;
		padding: 0.85rem 1rem;
		background: rgba(15, 118, 110, 0.07);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.content :global(.insight-strip strong) {
		color: var(--teal);
	}

	.content :global(.section-callout) {
		margin: 1rem 0 1.2rem;
		border: 1px solid rgba(231, 111, 81, 0.2);
		border-radius: 14px;
		padding: 1rem 1.1rem;
		background: rgba(231, 111, 81, 0.06);
	}

	.content :global(.section-callout > strong) {
		color: var(--coral);
		font-size: 0.82rem;
		font-weight: 900;
	}

	.content :global(.section-callout p) {
		margin: 0.35rem 0 0;
		font-size: 0.94rem;
		line-height: 1.65;
	}

	.content :global(.school-list) {
		display: grid;
		gap: 0.72rem;
		margin: 1rem 0 2rem;
	}

	.content :global(.school-card) {
		overflow: hidden;
		border: 1px solid rgba(17, 24, 39, 0.1);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.76);
		box-shadow: 0 8px 24px rgba(17, 24, 39, 0.045);
	}

	.content :global(.school-card[open]) {
		border-color: rgba(15, 118, 110, 0.24);
		box-shadow: 0 14px 34px rgba(17, 24, 39, 0.07);
	}

	.content :global(.school-card summary) {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto auto;
		align-items: center;
		gap: 0.65rem 0.8rem;
		padding: 0.9rem 1rem;
		cursor: pointer;
		list-style: none;
	}

	.content :global(.school-card summary::-webkit-details-marker) {
		display: none;
	}

	.content :global(.school-card summary::after) {
		grid-column: 4;
		color: var(--teal);
		content: "+";
		font-size: 1.15rem;
		font-weight: 800;
		line-height: 1;
	}

	.content :global(.school-card[open] summary::after) {
		content: "−";
	}

	.content :global(.school-code) {
		border-radius: 999px;
		padding: 0.18rem 0.55rem;
		background: rgba(15, 118, 110, 0.1);
		color: var(--teal);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.72rem;
		font-weight: 800;
		line-height: 1.4;
		white-space: nowrap;
	}

	.content :global(.school-card summary strong) {
		min-width: 0;
		color: var(--surface-strong);
		font-size: 0.98rem;
		line-height: 1.45;
	}

	.content :global(.school-plan-total) {
		color: var(--muted);
		font-size: 0.76rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.content :global(.school-card-body) {
		border-top: 1px solid rgba(17, 24, 39, 0.08);
		padding: 1rem;
		background: rgba(247, 249, 248, 0.72);
	}

	.content :global(.school-meta-grid) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.65rem;
	}

	.content :global(.school-meta-grid > div) {
		min-width: 0;
		border: 1px solid rgba(17, 24, 39, 0.07);
		border-radius: 10px;
		padding: 0.68rem 0.75rem;
		background: rgba(255, 255, 255, 0.82);
	}

	.content :global(.school-meta-grid span) {
		display: block;
		margin-bottom: 0.18rem;
		color: var(--muted);
		font-size: 0.7rem;
		font-weight: 900;
		letter-spacing: 0.08em;
	}

	.content :global(.school-meta-grid p) {
		margin: 0;
		color: #27313d;
		font-size: 0.86rem;
		line-height: 1.55;
		overflow-wrap: anywhere;
	}

	.content :global(.lawyer-card .school-plan-total) {
		max-width: 28rem;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.content :global(.lawyer-profile-grid > .profile-wide) {
		grid-column: 1 / -1;
	}

	.content :global(.school-links) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.8rem;
	}

	.content :global(.school-link) {
		border: 1px solid rgba(15, 118, 110, 0.18);
		border-radius: 999px;
		padding: 0.34rem 0.68rem;
		background: white;
		font-size: 0.76rem;
		line-height: 1.35;
		text-decoration: none;
	}

	.content :global(.school-link-primary) {
		border-color: transparent;
		background: var(--teal);
		color: white;
	}

	.content :global(.school-link-success) {
		border-color: rgba(46, 125, 88, 0.2);
		background: rgba(46, 125, 88, 0.09);
		color: #246a49;
	}

	.content :global(.table-tip) {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0.8rem 0 -0.55rem;
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 700;
	}

	.content :global(.table-tip span) {
		display: inline-grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		border-radius: 50%;
		background: rgba(15, 118, 110, 0.1);
		color: var(--teal);
	}

	.content :global(a) {
		color: var(--teal);
		font-weight: 700;
	}

	.content :global(blockquote) {
		margin: 1.4rem 0;
		border-left: 4px solid var(--coral);
		padding: 0.4rem 0 0.4rem 1rem;
		color: var(--muted);
	}

	.content :global(table) {
		display: block;
		width: 100%;
		overflow-x: auto;
		margin: 1.4rem 0;
		border: 1px solid var(--line);
		border-radius: 12px;
		border-collapse: separate;
		border-spacing: 0;
		background: rgba(255, 255, 255, 0.7);
		box-shadow: 0 12px 30px rgba(17, 24, 39, 0.055);
		font-size: 0.88rem;
		line-height: 1.5;
		-webkit-overflow-scrolling: touch;
	}

	/* Only data-dense tables need to extend beyond the article column. */
	.content--wide-tables :global(table:has(tr > :nth-child(7))) {
		width: min(1200px, calc(100vw - 32px));
		max-width: none;
		margin-right: 0;
		margin-left: 50%;
		transform: translateX(-50%);
	}

	/* Keep short lookup tables compact instead of stretching them to 1200px. */
	.content--wide-tables :global(table:not(:has(tr > :nth-child(7)))) {
		width: fit-content;
		max-width: 100%;
		margin-right: auto;
		margin-left: 0;
	}

	.content :global(th),
	.content :global(td) {
		min-width: 7rem;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		padding: 0.65rem 0.75rem;
		text-align: left;
		vertical-align: top;
	}

	.content :global(th) {
		background: rgba(15, 118, 110, 0.08);
		color: var(--surface-strong);
		font-weight: 800;
	}

	.content :global(table tr > :first-child) {
		position: sticky;
		left: 0;
		z-index: 2;
		background: #fbfaf6;
		box-shadow: 6px 0 12px rgba(17, 24, 39, 0.04);
	}

	.content :global(table th:first-child) {
		z-index: 3;
		background: #eaf4f2;
	}

	.content :global(table td strong) {
		color: var(--teal);
		font-size: 0.96rem;
	}

	.content :global(tr:nth-child(even) td) {
		background: rgba(244, 247, 246, 0.68);
	}

	.content :global(tr:nth-child(even) td:first-child) {
		background: #f1f5f3;
	}

	.content :global(.trend-grid) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 1.2rem 0 1.6rem;
	}

	.content :global(.trend-card) {
		border: 1px solid rgba(17, 24, 39, 0.08);
		border-radius: 16px;
		padding: 1.2rem;
		background: rgba(255, 255, 255, 0.72);
		box-shadow: 0 12px 32px rgba(17, 24, 39, 0.055);
	}

	.content :global(.trend-up) {
		border-top: 4px solid var(--coral);
	}

	.content :global(.trend-down) {
		border-top: 4px solid var(--teal);
	}

	.content :global(.trend-label) {
		margin: 0;
		color: var(--muted);
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0.1em;
	}

	.content :global(.trend-card h3) {
		margin: 0.15rem 0 0.8rem;
		font-size: 1.25rem;
	}

	.content :global(.trend-card ul) {
		display: grid;
