---
import { getCollection } from 'astro:content';
import heroJourney from '../assets/hero-journey.jpg';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('zh-CN', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}).format(date);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const postHref = (id: string) => `${base}/blog/${id}/`;
const zhongkaoTopicHref = `${base}/topics/2026-shanghai-zhongkao/`;
---

<Layout title="滴闯关" description="闯关记录、学习笔记和日常复盘">
	<main class="site-shell">
		<section class="hero">
			<div class="hero-copy">
				<p class="eyebrow">学习日志 / 闯关记录</p>
				<h1>把每次学习，都写成一关一关的记录。</h1>
				<p class="intro">这里放技术学习、项目复盘、读书笔记，以及那些值得慢慢攒起来的经验值。</p>
			</div>
			<div class="visual-board" aria-hidden="true">
				<img src={heroJourney.src} alt="" />
				<div class="visual-content">
					<p>已发布</p>
					<strong>{posts.length}</strong>
					<span>篇闯关记录</span>
				</div>
			</div>
		</section>

		<section class="topic-entry" aria-labelledby="zhongkao-topic-title">
			<div class="topic-entry-copy">
				<p class="topic-kicker">Featured topic</p>
				<h2 id="zhongkao-topic-title">2026上海中考升学专题</h2>
				<p>按“学校方案 → 录取查询 → 中本贯通对比”集中阅读3篇核心资料，快速找到与你当前阶段对应的入口。</p>
				<ul aria-label="专题覆盖内容">
					<li>95所高中自招方案</li>
					<li>预录取与正式录取查询</li>
					<li>86个中本贯通项目</li>
				</ul>
			</div>
			<a class="topic-entry-link" href={zhongkaoTopicHref}>按阶段开始阅读 <span>→</span></a>
		</section>

		<section class="section-heading" aria-labelledby="latest-posts">
			<p>Latest</p>
			<h2 id="latest-posts">最新文章</h2>
		</section>

		<section class="post-grid" aria-label="文章列表">
			{
				posts.map((post, index) => (
					<article class="post-item">
						<a href={postHref(post.id)}>
							<div class="post-number">{String(index + 1).padStart(2, '0')}</div>
							<div class="post-body">
								<div class="post-meta">
									<time datetime={post.data.pubDate.toISOString()}>
										{formatDate(post.data.pubDate)}
									</time>
									{post.data.tags[0] && <span>{post.data.tags[0]}</span>}
								</div>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
								{post.data.tags.length > 0 && (
									<ul class="tags" aria-label="标签">
										{post.data.tags.map((tag) => (
											<li>{tag}</li>
										))}
									</ul>
								)}
							</div>
						</a>
					</article>
				))
			}
		</section>
	</main>
</Layout>

<style>
	.site-shell {
		width: min(1120px, calc(100% - 32px));
		margin: 0 auto;
		padding: 40px 0 84px;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 440px);
		gap: 44px;
		align-items: center;
		margin-bottom: 68px;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 20px 0;
	}

	.eyebrow {
		margin: 0;
		color: var(--teal);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1 {
		max-width: 720px;
		margin: 14px 0 18px;
		font-size: clamp(2.35rem, 5vw, 3.6rem);
		line-height: 1.1;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.intro {
		max-width: 34rem;
		margin: 0;
		color: var(--muted);
		font-size: 1.06rem;
		font-weight: 650;
	}

	.topic-entry {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 28px;
		align-items: center;
		margin-bottom: 58px;
		border: 1px solid rgba(15, 118, 110, 0.2);
		border-radius: 14px;
		padding: 28px 30px;
		background:
			linear-gradient(120deg, rgba(15, 118, 110, 0.09), rgba(255, 255, 255, 0.74)),
			rgba(255, 255, 255, 0.7);
		box-shadow: 0 12px 32px rgba(17, 24, 39, 0.05);
	}

	.topic-kicker {
		margin: 0;
		color: var(--coral);
		font-size: 0.78rem;
		font-weight: 850;
		text-transform: uppercase;
	}

	.topic-entry h2 {
		margin: 5px 0 8px;
		font-size: clamp(1.55rem, 4vw, 2.25rem);
		line-height: 1.2;
	}

	.topic-entry-copy > p:last-of-type {
		max-width: 700px;
		margin: 0;
		color: var(--muted);
	}

	.topic-entry ul {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
	}

	.topic-entry li {
		border: 1px solid rgba(15, 118, 110, 0.17);
		border-radius: 999px;
		padding: 3px 10px;
		background: rgba(255, 255, 255, 0.64);
		color: var(--teal);
		font-size: 0.82rem;
		font-weight: 720;
	}

	.topic-entry-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		border-radius: 10px;
		padding: 12px 16px;
		background: var(--surface-strong);
		color: white;
		font-weight: 800;
		text-decoration: none;
		white-space: nowrap;
	}

	.topic-entry-link:hover,
	.topic-entry-link:focus-visible {
		background: var(--teal);
	}

	.visual-board {
		position: relative;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		border: 1px solid rgba(17, 24, 39, 0.08);
		border-radius: 8px;
		background: var(--surface);
		box-shadow: var(--shadow);
	}

	.visual-board img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.visual-content {
		position: absolute;
		right: 18px;
		bottom: 18px;
		z-index: 1;
		display: flex;
		min-width: 128px;
		flex-direction: column;
		justify-content: flex-end;
		border: 1px solid rgba(255, 255, 255, 0.26);
		border-radius: 8px;
		padding: 14px 16px 16px;
		background: rgba(17, 24, 39, 0.78);
		color: #fff;
		backdrop-filter: blur(14px);
	}

	.visual-content p,
	.visual-content span {
		margin: 0;
		color: rgba(255, 255, 255, 0.82);
		font-weight: 700;
	}

	.visual-content strong {
		margin: 2px 0;
		font-size: 3.25rem;
		line-height: 0.9;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 18px;
		border-bottom: 1px solid var(--line);
		padding-bottom: 14px;
	}

	.section-heading p,
	.section-heading h2 {
		margin: 0;
	}

	.section-heading p {
		color: var(--coral);
		font-size: 0.86rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.section-heading h2 {
		font-size: clamp(1.45rem, 4vw, 2rem);
		letter-spacing: 0;
	}

	.post-grid {
		display: grid;
		gap: 14px;
	}

	.post-item {
		border: 1px solid rgba(17, 24, 39, 0.08);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.72);
		box-shadow: 0 1px 0 rgba(17, 24, 39, 0.04);
		transition:
			border-color 180ms ease,
			box-shadow 180ms ease,
			transform 180ms ease;
	}

	.post-item a {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		gap: 20px;
		padding: 22px;
		text-decoration: none;
	}

	.post-item:hover,
	.post-item:has(a:focus-visible) {
		border-color: rgba(15, 118, 110, 0.36);
		box-shadow: 0 18px 34px rgba(17, 24, 39, 0.08);
		transform: translateY(-2px);
	}

	.post-number {
		display: grid;
		width: 48px;
		height: 48px;
		place-items: center;
		border-radius: 8px;
		background: #111827;
		color: white;
		font-size: 0.88rem;
		font-weight: 800;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
		color: var(--muted);
		font-size: 0.88rem;
		font-weight: 700;
	}

	.post-meta span {
		color: var(--teal);
	}

	h3 {
		margin: 7px 0 8px;
		font-size: clamp(1.35rem, 4vw, 2.05rem);
		line-height: 1.2;
		letter-spacing: 0;
	}

	.post-body > p {
		margin: 0;
		color: var(--muted);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		border: 1px solid rgba(15, 118, 110, 0.2);
		border-radius: 999px;
		padding: 3px 10px;
		background: rgba(15, 118, 110, 0.08);
		color: var(--teal);
		font-size: 0.85rem;
		font-weight: 700;
	}

	@media (max-width: 820px) {
		.site-shell {
			padding-top: 32px;
		}

		.hero {
			grid-template-columns: 1fr;
			gap: 22px;
			margin-bottom: 48px;
		}

		.hero-copy {
			padding: 16px 0 8px;
		}

		h1 {
			max-width: 34rem;
			font-size: clamp(2.25rem, 6.7vw, 2.85rem);
			line-height: 1.12;
		}

		.visual-board {
			aspect-ratio: 16 / 11;
		}
	}

	@media (max-width: 560px) {
		.site-shell {
			padding-top: 28px;
		}

		h1 {
			font-size: clamp(2rem, 9vw, 2.35rem);
			line-height: 1.14;
		}

		.intro {
			font-size: 1rem;
		}

		.topic-entry {
			grid-template-columns: 1fr;
			padding: 22px;
		}

		.topic-entry-link {
			justify-content: space-between;
		}

		.visual-content {
			right: 12px;
			bottom: 12px;
			min-width: 108px;
			padding: 10px 12px 12px;
		}

		.visual-content strong {
			font-size: 2.4rem;
		}

		.post-item a {
			grid-template-columns: 1fr;
			gap: 14px;
			padding: 18px;
		}

		.post-number {
			width: 42px;
			height: 42px;
		}
	}
</style>
